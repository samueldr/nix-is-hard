{ lib }:

# This file presents aliases for the common useful bit patterns.
{
  # Single bit set.
  b00000001 =                                     1; # 0x1
  b00000010 =                                     2; # 0x2
  b00000100 =                                     4; # 0x4
  b00001000 =                                     8; # 0x8
  b00010000 =                                    16; # 0x10
  b00100000 =                                    32; # 0x20
  b01000000 =                                    64; # 0x40
  b10000000 =                                   128; # 0x80
  b00000001_00000000 =                          256; # 0x100
  b00000010_00000000 =                          512; # 0x200
  b00000100_00000000 =                         1024; # 0x400
  b00001000_00000000 =                         2048; # 0x800
  b00010000_00000000 =                         4096; # 0x1000
  b00100000_00000000 =                         8192; # 0x2000
  b01000000_00000000 =                        16384; # 0x4000
  b10000000_00000000 =                        32768; # 0x8000
  b00000001_00000000_00000000 =               65536; # 0x10000
  b00000010_00000000_00000000 =              131072; # 0x20000
  b00000100_00000000_00000000 =              262144; # 0x40000
  b00001000_00000000_00000000 =              524288; # 0x80000
  b00010000_00000000_00000000 =             1048576; # 0x100000
  b00100000_00000000_00000000 =             2097152; # 0x200000
  b01000000_00000000_00000000 =             4194304; # 0x400000
  b10000000_00000000_00000000 =             8388608; # 0x800000
  b00000001_00000000_00000000_00000000 =   16777216; # 0x1000000
  b00000010_00000000_00000000_00000000 =   33554432; # 0x2000000
  b00000100_00000000_00000000_00000000 =   67108864; # 0x4000000
  b00001000_00000000_00000000_00000000 =  134217728; # 0x8000000
  b00010000_00000000_00000000_00000000 =  268435456; # 0x10000000
  b00100000_00000000_00000000_00000000 =  536870912; # 0x20000000
  b01000000_00000000_00000000_00000000 = 1073741824; # 0x40000000
  b10000000_00000000_00000000_00000000 = 2147483648; # 0x80000000

  # All bits set.
  b11111111                            =        255; # 0xff
  b11111111_11111111                   =      65535; # 0xffff
  b11111111_11111111_11111111_11111111 = 4294967295; # 0xffffffff
  # ... except for 64 bit (not representable)
  b01111111_11111111_11111111_11111111_11111111_11111111_11111111_11111111
  = 9223372036854775807; # 0x7fffffffffffffff
}
